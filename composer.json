{
    "name": "brufdev/many-notes",
    "description": "Markdown note-taking web application designed for simplicity",
    "version": "0.16.0",
    "type": "project",
    "homepage": "https://github.com/brufdev/many-notes",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "inertiajs/inertia-laravel": "^2.0.24",
        "laravel/framework": "^12.60.2",
        "laravel/reverb": "^1.10.2",
        "laravel/scout": "^10.25.0",
        "laravel/socialite": "^5.27",
        "laravel/tinker": "^2.11.1",
        "laravel/wayfinder": "^0.1.20",
        "socialiteproviders/authelia": "^4.0",
        "socialiteproviders/authentik": "^5.3",
        "socialiteproviders/keycloak": "^5.3",
        "socialiteproviders/microsoft-azure": "^5.2",
        "socialiteproviders/pocketid": "^5.1",
        "socialiteproviders/zitadel": "^4.2",
        "staudenmeir/eloquent-has-many-deep": "^1.21.3",
        "staudenmeir/laravel-adjacency-list": "^1.25.2",
        "typesense/typesense-php": "^6.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16.5",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.9.6",
        "laravel/pint": "^1.29.1",
        "laravel/sail": "^1.60.0",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.4",
        "pestphp/pest": "^4.7.0",
        "pestphp/pest-plugin-browser": "^4.3.1",
        "pestphp/pest-plugin-type-coverage": "^4.0.4",
        "rector/rector": "^2.4.4",
        "squizlabs/php_codesniffer": "^4.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "rector": "rector --dry-run",
        "pint": "pint --parallel --test",
        "phpcs": "phpcs --standard=PSR12 app database/factories database/migrations database/seeders routes tests/Feature tests/Unit",
        "phpstan": "phpstan",
        "fix:rector": "rector",
        "fix:pint": "pint --parallel",
        "test": "pest --parallel",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:coverage": "pest --parallel --coverage",
        "analyse": [
            "@rector",
            "@pint",
            "@phpcs",
            "@phpstan",
            "@test:type-coverage"
        ],
        "fix": [
            "@fix:rector",
            "@fix:pint"
        ],
        "ci": [
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "bump-after-update": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
